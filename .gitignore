# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Environment and local config
.env
config/local.yaml
.python-version

# Testing
.pytest_cache/
.coverage
htmlcov/

# Linting
.ruff_cache/

# Reports (generated)
.reports/

# Task runner checksums
.task/

# Automated Security Helper (ASH)
.ash/

# IDE / Editor
.idea/
*.swp
*.swo
*~

# Kiro (settings are machine-specific, steering/hooks are shared)
.kiro/settings/
.kiro/specs/

# OS
.DS_Store
Thumbs.db

# Bedrock AgentCore build artifacts and config
.bedrock_agentcore/
.bedrock_agentcore.yaml
.bedrock_agentcore.yaml.*

# Shared runtime copied into agent dirs at deploy time (see deploy_agent.sh)
agents/*/shared/

# Generated API documentation
api/docs/

# Terraform (all stacks)
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars.backup
# Bare plan files at any depth (terraform -out=tfplan); the *.tfplan rule
# above only matches the extension, so this catches extensionless `tfplan`.
tfplan
**/tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
backend.hcl
terraform/*.zip
terraform/.tflint.hcl

# Lambda build artifacts
.build/

# Generated frontend config (created by Terraform)
frontend/public/config.json

# Frontend build artifacts and dependencies
frontend/node_modules/
frontend/dist/

# PlantUML Diagrams
documentation/diagrams


# Internal management docs (not tracked in repo)
CODE_MANAGEMENT.md
PUBLISHING_RUNBOOK.md
DEPLOYMENT.md
pre-deploy-test.md

# OIDC / federation client secret (uploaded out-of-band, never committed).
# Both names are ignored so the secret can never be accidentally committed,
# regardless of which filename the upload step uses.
midway_client_secret
oidc_client_secret

# Slingshot packaging output
assess-workbench.zip

# Terraform backend configs are account-specific (bucket name embeds the
# account ID). Each developer creates their own from the committed template;
# the real <env>.hcl files are never tracked.
terraform/backends/*.hcl
!terraform/backends/example.hcl.template

# Slingshot security review artifacts (raw findings + remediation tracking —
# these enumerate where the vulnerabilities are; keep out of git history)
.design_specs/slingshot-results.json
.design_specs/slingshot-remediation.md
Assess_Workbench_*.json
