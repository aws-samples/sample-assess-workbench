# AWS Configuration
AWS_REGION=us-west-2
# AWS_PROFILE is optional. Leave it commented out to use your default AWS
# credentials. Set it to a named profile only if your account is not the
# default one. Leave it commented (not blank) when unused — an empty value is
# treated by the AWS CLI as a profile literally named "".
# AWS_PROFILE=

# Deployment Configuration
PYTHON_RUNTIME=PYTHON_3_13
ENVIRONMENT=dev
PROJECT_NAME=risk-assessor

# Model Configuration
PLANNER_MODEL_ID=us.anthropic.claude-sonnet-4-6
JUDGE_MODEL_ID=us.anthropic.claude-sonnet-4-6
IMAGE_ANALYSIS_MODEL_ID=us.anthropic.claude-sonnet-4-6
GENERATOR_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Test Configuration (used by tests/live/)
# TEST_USER_EMAIL=your-cognito-user@example.com
# TEST_USER_PASSWORD=your-password